# Firebase — Admin SDK (server only, NEVER commit real values)
# Console → Project settings → Service accounts → Generate new private key
# Paste the private key with literal \n escapes, wrapped in double quotes.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Deepgram — https://console.deepgram.com → API Keys
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
# nova-3 is the current best general model. Use language=multi for code-switching.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# ---------------------------------------------------------------------------
# OpenRouter — https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Default model for transcript chat. Any slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Optional, shows up in OpenRouter's dashboard / rankings
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Recorder

